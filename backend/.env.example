# If set, DATABASE_URL wins over the discrete DB_* vars below (Railway's
# Postgres plugin only ever provides DATABASE_URL, referenced as
# ${{ Postgres.DATABASE_URL }} in the backend service's variables).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintech_expenses
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fintech_expenses
# Set to "true" only when connecting through a proxy that terminates TLS with
# a certificate not chained to a public CA (e.g. Railway's public Postgres
# proxy). Not needed on Railway's private network (the default DATABASE_URL).
DB_SSL=false
JWT_SECRET=your-secret-key-here
NODE_ENV=development
PORT=3000
# Origins allowed to call this API (CORS).
# Accepts a comma-separated list, e.g.:
#   FRONTEND_URL=https://my-app.vercel.app,https://staging.my-app.vercel.app
# In non-production any http://localhost:<port> / http://127.0.0.1:<port> is allowed too.
FRONTEND_URL=http://localhost:5173
